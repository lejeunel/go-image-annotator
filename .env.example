# go-image-annotator example configuration
#
# Copy this file to .env and adjust the values:
#
#   cp .env.example .env
#
# Variables marked [required] must be set. Commented-out variables are
# optional and show their default value.

# --- Server -------------------------------------------------------------

# Public base URL of the app.
# GOIA_URL=localhost


# --- Database [required] ------------------------------------------------

# Path to the SQLite database file. It is created on first start; the parent
# directory must exist and be writable.
GOIA_DB_PATH=/var/lib/go-image-annotator/db.sqlite


# --- Image storage [required] -------------------------------------------

# Where raw images are stored. Two schemes are supported:
#   file:///absolute/path        local file-system
#   s3://bucket/optional/prefix  S3-compatible object store
GOIA_IMAGES_URI=file:///var/lib/go-image-annotator/images

# S3 only. On AWS, leave these unset to use the standard credential chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws, or an IAM role).
# For other providers (MinIO, Backblaze, ...), set the endpoint and both keys.
# GOIA_S3_ENDPOINT=https://minio.example.com
# GOIA_S3_REGION=us-east-1
# GOIA_S3_ACCESS_KEY=
# GOIA_S3_SECRET=
# MinIO and most self-hosted stores need path-style addressing.
# GOIA_S3_USE_PATH_STYLE=false


# --- Initial administrator [required] -----------------------------------

# Account created on first start, when no admin exists yet. Ignored once
# the admin role exists, so changing these later has no effect.
# The password must pass the entropy check (see GOIA_PASSWORD_MIN_ENTROPY);
# change it after your first login.
GOIA_INITIAL_ADMIN_EMAIL=admin@example.com
GOIA_INITIAL_ADMIN_PASSWORD=change-me-to-a-long-random-passphrase


# --- Notification (SMTP) -------------------------------------------------

# Used to send password reset links. Leave GOIA_SMTP_HOST unset to disable
# email.
# GOIA_SMTP_HOST=smtp.example.com
# Usually 587 (STARTTLS).
# GOIA_SMTP_PORT=587
# Also used as the sender address.
# GOIA_SMTP_USERNAME=noreply@example.com
# GOIA_SMTP_PASSWORD=


# --- OAuth sign-in ------------------------------------------------------

# Each provider is enabled when both its client id and secret are set.
# Register the following callbacks URLs:
#   <GOIA_URL>:<port>/auth/callback/google
#   <GOIA_URL>:<port>/auth/callback/github
# GOIA_GOOGLE_CLIENT_ID=
# GOIA_GOOGLE_CLIENT_SECRET=
# GOIA_GITHUB_CLIENT_ID=
# GOIA_GITHUB_CLIENT_SECRET=

# Key used to sign OAuth session cookies. Required, with at least 32
# characters, as soon as a provider is enabled. Generate one with:
#   openssl rand -base64 32
# GOIA_SESSION_SECRET=


# --- Limits and tuning --------------------------------------------------

# Comma-separated list of accepted image types.
# GOIA_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png

# Pagination.
# GOIA_DEFAULT_PAGE_SIZE=20
# GOIA_MAX_PAGE_SIZE=50

# Maximum size of an uploaded archive, in megabytes.
# GOIA_MAX_ARCHIVE_MB=500

# Number of background tasks kept per user; older ones are deleted.
# GOIA_MAX_NUM_TASKS_PER_USER=50

# Length of generated API tokens.
# GOIA_API_TOKEN_LENGTH=32

# Length of generated temporary passwords.
# GOIA_RANDOM_PASSWORD_LENGTH=10

# Minimum password strength, in bits of entropy.
# GOIA_PASSWORD_MIN_ENTROPY=50

# Validity of a password reset link, in minutes.
# GOIA_FORGOT_PASSWORD_TOKEN_EXPIRATION_MINUTES=30
